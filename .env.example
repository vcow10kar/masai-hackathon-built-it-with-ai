# --- Transcript storage -------------------------------------------------
# With both set, transcripts are stored in Supabase, which is what makes the
# deployed app work. Without them, they are written to data/lectures/ locally.
# Run supabase/schema.sql once before using these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Transcript source --------------------------------------------------
# Fetches captions over HTTP. Required when deployed, since yt-dlp cannot run
# there. Without it, the local yt-dlp toolchain is used.
SUPADATA_API_KEY=

# Speech to text for links that have no captions, such as a direct MP4. The
# service fetches the URL itself, which is what makes it work when deployed.
# Without it, videos without captions are transcribed by local whisper.cpp.
DEEPGRAM_API_KEY=

# A transcription server you run yourself, usually this machine exposed through
# a tunnel. Takes priority over Deepgram when set. Start it with
# `npm run transcribe:server` and use the same token on both sides.
TRANSCRIBE_URL=
TRANSCRIBE_TOKEN=
# TRANSCRIBE_TIMEOUT_MS=840000
# WHISPER_MODEL=small.en

# An answering server you run yourself, usually this machine exposed through a
# tunnel, sharing TRANSCRIBE_TOKEN. Used when OpenRouter is not configured.
ANSWER_URL=
# ANSWER_MODEL=gpt-oss:20b
# ANSWER_TIMEOUT_MS=300000
# ANSWER_CONTEXT=2048
# ANSWER_MAX_TOKENS=512

# --- Answering ----------------------------------------------------------
# The ask route uses the first provider with a key, falling back to local Ollama.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=gpt-oss:20b
